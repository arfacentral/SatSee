# Copy this file to .env.local (never committed) and paste your CARTO raster tile URL.
# It must contain {z}/{x}/{y} placeholders. Leave empty to use the key-free Esri dark basemap.
VITE_CARTO_TILE_URL=

# Optional: free key from https://aisstream.io (sign in with GitHub) for GLOBAL live vessels.
# Used only by the local relay (npm run relay); never exposed to the browser.
AISSTREAM_API_KEY=
